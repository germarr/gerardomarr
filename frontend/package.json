{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --watch --import remix/node-tsx server.ts",
    "hmr": "NODE_ENV=development node hmr.ts",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "prerender": "NODE_ENV=production node --import remix/node-tsx prerender.ts",
    "test": "NODE_ENV=test remix test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "marked": "^18.0.10",
    "remix": "^3.0.0-beta.10"
  },
  "devDependencies": {
    "@types/node": "latest",
    "playwright": "^1.62.1",
    "typescript": "latest"
  }
}
